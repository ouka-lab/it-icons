#!/usr/bin/env sh
# Checks that the commit message starts with one of the allowed prefixes.
# The prefixes match the labels added by .github/workflows/label-pr.yml.
msg=$(head -n 1 "$1")

# Allow messages that git generates (merge / revert / fixup etc.)
if echo "$msg" | grep -qE '^(Merge|Revert|fixup!|squash!|amend!) '; then
  exit 0
fi

if ! echo "$msg" | grep -qE '^(feature|fix|docs|chore|new-icon)(\([^)]+\))?!?: .+'; then
  echo "✖ The commit message must start with one of these prefixes:" >&2
  echo "    feature: / fix: / docs: / chore: / new-icon:" >&2
  echo "  e.g. feature: add antigravity icon" >&2
  echo "  Received message: $msg" >&2
  exit 1
fi
